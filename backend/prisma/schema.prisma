// Prisma Schema for Digital Asset Management (DAM) Platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// 1. User Roles
enum Role {
  USER
  ADMIN
}

// 2. Asset Processing Status Enum
enum AssetStatus {
  PENDING_UPLOAD
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

// 3. User Account Model
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relation: One User can upload many Assets
  assets       Asset[]

  @@map("users")
}

// 4. Main Asset Metadata Model
model Asset {
  id                 String      @id @default(uuid())
  originalName       String
  mimeType           String
  size               Int
  rawPath            String
  // Optional fields - populated after worker completes processing
  thumbnailUrl       String?
  transcoded720pUrl  String?
  transcoded1080pUrl String?
  status             AssetStatus @default(PENDING_UPLOAD)
  errorMessage       String?
  downloadCount      Int         @default(0)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  // Uploader Relation: Links asset to its contributor
  uploaderId         String
  uploader           User        @relation(fields: [uploaderId], references: [id], onDelete: Cascade)

  tags               AssetTag[]

  @@map("assets")
}

// 5. Taxonomy Tag Model
model Tag {
  id        String     @id @default(uuid())
  name      String     @unique
  createdAt DateTime   @default(now())

  assets    AssetTag[]

  @@map("tags")
}

// 6. Many-to-Many Join Table (Asset <-> Tag)
model AssetTag {
  assetId String
  tagId   String

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  tag   Tag   @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([assetId, tagId])
  @@map("asset_tags")
}
