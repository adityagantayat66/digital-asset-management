// Prisma Schema for Logger Microservice

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum AssetStatus {
  PENDING_UPLOAD
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  assets       Asset[]

  @@map("users")
}

model Asset {
  id                 String      @id @default(uuid())
  originalName       String
  mimeType           String
  size               Int
  rawPath            String
  thumbnailUrl       String?
  transcodedSdUrl    String?
  transcoded720pUrl  String?
  transcoded1080pUrl String?
  checksum           String?
  status             AssetStatus @default(PENDING_UPLOAD)
  errorMessage       String?
  downloadCount      Int         @default(0)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  uploaderId         String
  uploader           User        @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  tags               AssetTag[]

  @@map("assets")
}

model Tag {
  id        String     @id @default(uuid())
  name      String     @unique
  createdAt DateTime   @default(now())
  assets    AssetTag[]

  @@map("tags")
}

model AssetTag {
  assetId String
  tagId   String
  asset   Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)
  tag     Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([assetId, tagId])
  @@map("asset_tags")
}

model SystemLog {
  id            String   @id @default(uuid())
  timestamp     DateTime @default(now())
  level         String
  origin        String
  functionName  String
  message       String
  code          String?
  statusCode    Int?
  correlationId String?
  method        String?
  url           String?
  userId        String?
  ip            String?
  details       Json?
  stack         String?
  createdAt     DateTime @default(now())

  @@index([level])
  @@index([origin])
  @@index([correlationId])
  @@index([createdAt])
  @@map("system_logs")
}
