# Server Environments
NODE_ENV=development

# JWT Authentication
JWT_SECRET=dam_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# PostgreSQL Settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=dam_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/dam_db?schema=public

# Redis Settings
REDIS_HOST=redis
REDIS_PORT=6379

# RabbitMQ Settings
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672

# MinIO S3 Settings
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_HOST=minio
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_RAW_BUCKET=raw-assets
MINIO_PROCESSED_BUCKET=processed-assets

# Nginx & Frontend Ports
FRONTEND_PORT=3000
API_PORT=5000
