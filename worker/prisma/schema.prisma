// Prisma Schema for Digital Asset Management (DAM) Platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// 1. User Roles
enum Role {
  USER
  ADMIN
}

// 2. Asset Status Lifecycle Enum
enum AssetStatus {
  PENDING_UPLOAD
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

// 3. User Authentication & Authorization Model
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assets Asset[]

  @@map("users")
}

// 4. Main Asset Metadata Model
model Asset {
  id                 String      @id @default(uuid())
  originalName       String
  mimeType           String
  size               Int
  rawPath            String
  // Optional fields - populated after worker completes processing
  thumbnailUrl       String?
  transcodedSdUrl    String?
  transcoded720pUrl  String?
  transcoded1080pUrl String?
  status             AssetStatus @default(PENDING_UPLOAD)
  errorMessage       String?
  downloadCount      Int         @default(0)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  // Uploader Relation: Links asset to its contributor
  uploaderId String
  uploader   User     @relation(fields: [uploaderId], references: [id], onDelete: Cascade)

  tags AssetTag[]

  @@map("assets")
}

// 5. Taxonomy Tag Model
model Tag {
  id   String     @id @default(uuid())
  name String     @unique
  assets AssetTag[]

  @@map("tags")
}

// 6. Join Model for Many-to-Many Asset <-> Tag Taxonomy
model AssetTag {
  assetId String
  asset   Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  tagId String
  tag   Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([assetId, tagId])
  @@map("asset_tags")
}
